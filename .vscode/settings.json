{
	"files.readonlyInclude": {
		// Don't allow editing of generated route tree file
		"**/routeTree.gen.ts": true
	},

	"search.exclude": {
		// Don't search lock files
		"package-lock.json": true,
		"pnpm-lock.yaml": true,

		".agents": true,
		".pnpm-store": true
	},

	"workbench.editor.customLabels.patterns": {
		// Disambiguate generic filenames by including the folder name in the tab
		"**/{page,layout,loading,error,route,template}.{jsx,tsx}": "${dirname}/${filename}",
		"**/index.{html,js,jsx,ts,tsx}": "${dirname}/${filename}"
	},
	"workbench.iconTheme": "material-icon-theme",

	// General formatting
	"oxc.disableNestedConfig": true,
	"oxc.fmt.disableNestedConfig": true,
	"editor.defaultFormatter": "oxc.oxc-vscode",
	// Override each language's default formatter to ensure this takes precedence over user settings
	"[javascript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[html]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[css]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[tailwindcss]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[markdown]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[yaml]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"editor.codeActionsOnSave": {
		"source.fixAll": "always"
	},
	"editor.formatOnPaste": true,
	"editor.formatOnSave": true,
	"editor.formatOnSaveMode": "file",

	"files.associations": {
		"*.css": "tailwindcss"
	},

	// Language-specific settings
	"[prisma]": {
		"editor.defaultFormatter": "Prisma.prisma"
	},
	"[svg]": {
		"editor.defaultFormatter": "jock.svg"
	},

	"yaml.schemas": {
		"https://render.com/schema/render.yaml.json": "render{.*,}.yaml"
	},

	// Use the TypeScript SDK installed locally
	// "js/ts.tsdk.path": "node_modules/typescript/lib",
	// Use TypeScript 7 preview (tsgo)
	"js/ts.experimental.useTsgo": true,
	"js/ts.preferences.autoImportSpecifierExcludeRegexes": [
		// Exclude `console` to prefer our own logger
		"^(node:)?console$",
		// Exclude `os` to avoid clashing with `arktype`
		// https://arktype.io/docs/intro/setup#settings
		"^(node:)?os$"
	],

	// Tailwind & CSS
	"cssModules.camelCase": true,
	"tailwindCSS.classAttributes": ["class", "className", "classNames", ".*Styles*", ".*ClassName"],
	"tailwindCSS.classFunctions": ["clsx", "cx", "twMerge"],
	"tailwindCSS.experimental.classRegex": [":\\s*?[\"'`]([^\"'`]*).*?"],
	"tailwindCSS.rootFontSize": 16,

	// Stylelint
	"stylelint.reportDescriptionlessDisables": true,
	"stylelint.packageManager": "pnpm",
	"stylelint.reportInvalidScopeDisables": true,
	"stylelint.reportNeedlessDisables": true,
	"stylelint.snippet": ["css", "postcss", "tailwindcss"],
	"stylelint.validate": ["css", "postcss", "tailwindcss"],

	"npmx.ignore.replacement": ["dotenv"]
}
