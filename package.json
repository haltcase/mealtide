		"@tanstack/react-start": "^1.131.2",
		"immer": "^10.1.1",
		"lz-string": "^1.5.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-icons": "^5.5.0",
		"superjson": "^2.2.2",
