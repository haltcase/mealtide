{
	"name": "mealtide",
	"version": "1.0.0",
	"private": true,
	"description": "App to help figure out splits for lunch (or other) orders.",
	"keywords": [],
	"homepage": "https://mealtide.haltcase.dev",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite dev",
		"eslint:check": "eslint src",
		"format": "oxlint --fix && eslint --fix src && prettier --write src",
