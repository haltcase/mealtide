{
	"extends": "@haltcase/style/typescript/bundler",
	"compilerOptions": {
		"target": "ES2018",
		"baseUrl": "src",
		"paths": {
			"@/*": ["./*"]
		}
	},
	"exclude": ["node_modules"],
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"**/*.js",
		"**/*.jsx",
		"**/*.mjs",
		".*.js",
		".eslintrc.cjs",
		"postcss.config.js"
	]
}
